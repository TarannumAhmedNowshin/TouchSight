# Vision providers (at least one). Gemini is tried first, Groq second.
GEMINI_API_KEY=
GROQ_API_KEY=

# Optional overrides
# GEMINI_MODEL=            # default: newest Flash model your key can use
# GROQ_MODEL=qwen/qwen3.8-27b
# VLM_TIMEOUT_S=90
# ALLOWED_ORIGINS=http://localhost:3000   # comma-separated origins allowed to call the API
# RATE_LIMIT_PER_MIN=12                   # conversions per client per minute
# CACHE_DIR=./cache
